# 타깃 플랫폼 정의. --platforms 로 이걸 가리키면 Bazel 이 여기 붙은
# constraint 를 만족하는 툴체인을 자동으로 고른다(toolchain resolution).
package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)
